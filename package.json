{
  "name": "reel-queue",
  "version": "1.5.1",
  "description": "A local desktop queue for posting Instagram Reels, YouTube Shorts, and TikTok videos through visible Chrome sessions.",
  "main": "src/main.js",
  "author": "Yaascine",
  "license": "MIT",
  "homepage": "https://github.com/Yaascine/reel-queue",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yaascine/reel-queue.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.js",
    "pack": "npm run prepare:ffmpeg && electron-builder --dir",
    "pack:win": "node scripts/prepare-ffmpeg.js win32 x64 && electron-builder --win --x64 --dir",
    "dist:mac": "node scripts/prepare-ffmpeg.js darwin && electron-builder --mac --publish never",
    "dist:win": "node scripts/prepare-ffmpeg.js win32 x64 && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.local.reelqueue",
    "productName": "Reel Queue",
    "asar": true,
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg",
          "to": "ffmpeg/ffmpeg"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.LICENSE",
          "to": "ffmpeg/ffmpeg.LICENSE"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "ffmpeg/ffmpeg.exe"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.LICENSE",
          "to": "ffmpeg/ffmpeg.LICENSE"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
